# ---- LEASH .env.example (placeholders only — never commit real secrets) ----
# Privy (org treasury + policy engine + real-console login)
# obtain from: dashboard.privy.io (app id + secret); NEXT_PUBLIC is the same app id for the client
PRIVY_APP_ID=cmtx_placeholder
PRIVY_APP_SECRET=privy_secret_placeholder
NEXT_PUBLIC_PRIVY_APP_ID=cmtx_placeholder
# WS7 A1 authz: Privy auth-token verification signing key for verifyAuthToken (@privy-io/server-auth ^1.32).
# Optional: if unset, verifyAuthToken({ appId, appSecret }) verifies via the app secret alone (no separate key required for ^1.32);
# set this to the app's public verification key (dashboard.privy.io) to verify offline without a network round-trip.
PRIVY_VERIFICATION_KEY=
# P-256 owner public key for the treasury wallet (INVARIANT #5) — obtain: generated at WS-0
TREASURY_OWNER_PUBKEY=p256_pubkey_placeholder

# Hedera testnet operator (facilitator fee-payer + minter) — ECDSA
# obtain from: portal.hedera.com (1000 HBAR/24h)
HEDERA_OPERATOR_ID=0.0.0
HEDERA_OPERATOR_EVM_ADDRESS=0x0000000000000000000000000000000000000000
HEDERA_OPERATOR_KEY=0xhex_placeholder
HEDERA_OPERATOR_KEY_DER=der_placeholder
HEDERA_NETWORK=testnet
HEDERA_EVM_RPC=https://testnet.hashio.io/api

# Ethereum Sepolia RPC (Alchemy) — obtain from: alchemy.com dashboard
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/KEY_PLACEHOLDER

# ENS deployer (writes + relayer gas) — obtain: generated at WS-0, fund with test ETH (faucet)
LEASH_DEPLOYER_KEY=0xhex_placeholder
LEASH_DEPLOYER_ADDRESS=0x72A90a712b7a668bD215B3b70B3fEaBFA40dd5C5

# Neon Postgres 16 (index layer AND, per WS7 A5, the durable replay seen_payments store: fail-closed on store error, INVARIANT #14). Obtain from: neon.tech (pooled connection string)
DATABASE_URL=postgres://user:pass@host/neondb?sslmode=require

# WS7 A5 / DS-5: Render keep-warm ping URL to avoid free-tier cold starts on the facilitator (a cron/uptime pinger hits this; use starter-plan for true durability). Leave blank if not using keep-warm.
KEEPWARM_URL=https://leash-facilitator.onrender.com/health

# Generated by scripts/setup.ts (do not fill manually)
ENS_PARENT_NAME=leash.eth
SANDBOX_ORG_NAME=acme.leash.eth
SANDBOX_REGISTRY=0x_generated
USDC_TOKEN_ID=0.0.generated
USDC_EVM_ADDRESS=0x_generated_hip719
HCS_TOPIC_ID=0.0.generated
TREASURY_WALLET_ID=privy_wallet_generated

# Generated per-agent + receiver (scripts/seed-demo.ts / setup) — obtain: generated
RECEIVER_ACCOUNT_ID=0.0.generated
RECEIVER_KEY=0xhex_generated
SANDBOX_AGENT_ACCOUNT=0.0.generated
SANDBOX_AGENT_KEY=0xhex_generated
SANDBOX_AGENT_EVM=0x_generated
SANDBOX_AGENT_WALLET_ID=privy_wallet_generated
SANDBOX_AGENT2_ACCOUNT=0.0.generated
SANDBOX_AGENT2_EVM=0x_generated

# Service URLs (set at deploy) — obtain: Render/Vercel deploy output
FACILITATOR_URL=https://leash-facilitator.onrender.com
RESOURCE_URL=https://leash-resource.onrender.com
RESOURCE_PORT=8402
# Optional: x402 endpoint price format switch (DP-3) — default $3.00
PREMIUM_PRICE=$3.00
